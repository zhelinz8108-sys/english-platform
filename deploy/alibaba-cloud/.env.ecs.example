# Copy this file to .env.ecs. Never commit or share the real file.
SITE_DOMAIN=101.37.18.48
WEB_ORIGIN=http://101.37.18.48
PLATFORM_WEB_PORT=3100

IMAGE_TAG=ecs-2026-07-22.1
API_IMAGE=english-platform-api
WORKER_IMAGE=english-platform-worker
WEB_IMAGE=english-platform-web

# Generate five different values with: openssl rand -hex 32
DB_OWNER_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
WORKER_DB_PASSWORD=REPLACE_WITH_RANDOM_WORKER_PASSWORD

# Hex passwords need no additional URL encoding.
DATABASE_ADMIN_URL=postgresql://english_owner:REPLACE_WITH_RANDOM_OWNER_PASSWORD@postgres:5432/english_platform
DATABASE_URL=postgresql://english_app:REPLACE_WITH_RANDOM_APP_PASSWORD@postgres:5432/english_platform
WORKER_DATABASE_URL=postgresql://english_worker:REPLACE_WITH_RANDOM_WORKER_PASSWORD@postgres:5432/english_platform
DATABASE_POOL_MAX=8
DATABASE_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Private Alibaba Cloud OSS bucket in cn-hangzhou. Use virtual-hosted requests.
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_REGION=cn-hangzhou
S3_BUCKET=REPLACE_WITH_PRIVATE_OSS_BUCKET
S3_ACCESS_KEY=REPLACE_WITH_LIMITED_RAM_ACCESS_KEY_ID
S3_SECRET_KEY=REPLACE_WITH_LIMITED_RAM_ACCESS_KEY_SECRET
S3_FORCE_PATH_STYLE=false

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=english-platform-api
